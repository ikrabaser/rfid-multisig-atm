# Ortam değişkenleri (PowerShell'de: $env:ADI="deger"). .env dosyası OTOMATİK okunmaz.
# Veritabanı: varsayılan PostgreSQL (docker-compose.yml ile uyumlu)
# DB_ENGINE=sqlite            # hızlı yerel deneme; eşzamanlılık testleri atlanır
# POSTGRES_DB=kasa
# POSTGRES_USER=kasa
# POSTGRES_PASSWORD=kasa
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Demo için süreler (saniye)
# ONAY_PENCERESI_SN=120       # onayların toplanma süresi (varsayılan 30)
# TESLIM_PENCERESI_SN=15      # para teslimi bildirim süresi (varsayılan 120); aşılırsa teslim "belirsiz" olur

# Web girişi
# GIRIS_MAKS_HATA=5           # kullanıcı adı başına hatalı deneme (varsayılan 5)
# GIRIS_KILIT_SN=600          # kilit / sayım penceresi (varsayılan 600)
# OTURUM_ZAMAN_ASIMI_SN=1800  # boşta oturum sonu (varsayılan 1800)
# RISK_MOTORU_AKTIF=1         # satır içi risk motoru (testlerde varsayılan kapalı); README "Satır içi risk motoru"
# RISK_EK_ONAY_ESIGI=40       # bu puan ve üstü: ek onay
# RISK_RED_ESIGI=80           # bu puan ve üstü: işlem reddedilir
# RISK_BLOKE_ESIGI=120        # bu puan ve üstü: reddedilir ve kart bloke edilir
# RISK_EK_ONAY_SAYISI=1       # risk nedeniyle istenen en az onay sayısı
# RISK_YENI_HESAP_TUTAR=5000  # geçmişi az hesapta bu tutar ve üstü şüpheli sayılır
# KART_IMZA_ZORUNLU=0         # 1: imzasız (klonlanabilir) kart reddedilir; imzalı kart simülasyonu, README "İmzalı kart"
# KART_IMZA_ANAHTARI=         # kart çipi anahtarlarının ana anahtarı (üretimde mutlaka değiştir)
# KART_IMZA_GECERLILIK_SN=90  # aynı okutmanın KART/PIN/ONAY adımları için yeniden kabul penceresi
# NAKIT_COZ_TEK_KISI=0        # belirsiz nakit için tek kişilik çözüm (varsayılan: yalnızca DEBUG)
