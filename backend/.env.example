# Ortam değişkenleri (PowerShell'de: $env:ADI="deger"). .env dosyası OTOMATİK okunmaz.
# Veritabanı: varsayılan PostgreSQL (docker-compose.yml ile uyumlu)
# DB_ENGINE=sqlite            # hızlı yerel deneme; eşzamanlılık testleri atlanır
# POSTGRES_DB=kasa
# POSTGRES_USER=kasa
# POSTGRES_PASSWORD=kasa
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Demo için süreler (saniye)
# ONAY_PENCERESI_SN=120       # onayların toplanma süresi (varsayılan 30)
# TESLIM_PENCERESI_SN=15      # para teslimi bildirim süresi (varsayılan 120); aşılırsa teslim "belirsiz" olur
